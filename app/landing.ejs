<div id="landingContainer" style="display: none;">
    <div id="dodoShell">

        <aside id="newsPane">
            <div id="image_seal_container">
                <img id="image_seal" src="assets/images/SealCircle.png"/>
                <span id="brandName">DodoShield</span>
                <div id="updateAvailableTooltip"><%- lang('landing.updateAvailableTooltip') %></div>
            </div>
            <div class="newsPaneLabel"><%- lang('landing.newsButton') %></div>
            <div id="newsList">
                <div class="newsPaneEmpty" id="newsPaneStatus"><%- lang('landing.newsErrorLoadSpan') %></div>
            </div>
        </aside>

        <main id="mainPane">

            <div id="topBar">
                <div id="user_content">
                    <div id="userMeta">
                        <span id="user_text"><%- lang('landing.usernamePlaceholder') %></span>
                        <span id="user_sub">Microsoft</span>
                    </div>
                    <div id="avatarContainer"></div>
                    <button id="avatarOverlay" title="<%- lang('landing.usernameEditButton') %>">
                        <svg class="avatarGear" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3.2"/>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                        </svg>
                    </button>
                </div>
            </div>

            <div id="centerStack">
                <div id="packTabs"></div>
                <h1 id="packTitle"><%- lang('landing.launchButtonPlaceholder') %></h1>
                <div id="packMeta">
                    <span id="server_status_wrapper">
                        <span id="serverStatusDot"></span>
                        <span id="landingPlayerLabel"><%- lang('landing.serverStatus') %></span>
                        <span id="player_count"><%- lang('landing.serverStatusPlaceholder') %></span>
                    </span>
                    <span class="metaSep">·</span>
                    <span id="packMcVersion">MC —</span>
                </div>
                <div id="updateSlot"><button id="updateNowButton" style="display: none;"></button></div>
                <div id="launch_content">
                    <button id="launch_button"><%- lang('landing.launchButton') %></button>
                </div>
                <div id="launch_details">
                    <div id="launch_details_left">
                        <progress id="launch_progress" value="0" max="100"></progress>
                        <span id="launch_progress_label">0%</span>
                    </div>
                    <div id="launch_details_right">
                        <span id="launch_details_text" class="bot_label"><%- lang('landing.launchDetails') %></span>
                    </div>
                </div>
                <button id="server_selection_button" class="bot_label"><%- lang('landing.launchButtonPlaceholder') %></button>
            </div>

            <div id="bottomBar">
                <span id="launcherVersionLabel"></span>
                <a id="donateLink" href="<%- lang('settings.donateLink') %>">❤ ДОНАТ</a>
                <span id="javaRamLabel"></span>
            </div>

        </main>
    </div>

    <!-- Kept only so the Mojang status refresher has somewhere to write. -->
    <div id="mojangStatusWrapper">
        <span id="mojang_status_icon">&#8226;</span>
        <div id="mojangStatusTooltip">
            <div id="mojangStatusTooltipTitle"><%- lang('landing.mojangStatusTooltipTitle') %></div>
            <div id="mojangStatusEssentialContainer"></div>
            <div id="mojangStatusNEContainer">
                <div id="mojangStatusNETitle"><%- lang('landing.mojangStatusNETitle') %></div>
            </div>
            <div id="mojangStatusNonEssentialContainer"></div>
        </div>
    </div>

    <script src="./assets/js/scripts/landing.js"></script>
</div>
